#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
slack_target=${TERMINAL_ELECTRON_SLACK_APP:-/Applications/Slack.app}
if [ -z "${TERMINAL_ELECTRON_SLACK_APP:-}" ] && [ ! -d "$slack_target" ]; then
  slack_target="$script_dir/../Slack.app"
fi
if [ ! -d "$slack_target" ]; then
  echo 'Install Slack or set TERMINAL_ELECTRON_SLACK_APP to its .app path.' >&2
  exit 1
fi
profile=${TERMINAL_ELECTRON_SLACK_PROFILE:-$script_dir/profiles/slack-desktop}
if [ -f "$profile/.terminal-electron-profile.json" ]; then
  exec "$script_dir/terminal-electron" "$slack_target" --profile "$profile" "$@"
fi
app_name=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleName' "$slack_target/Contents/Info.plist")
exec "$script_dir/terminal-electron" "$slack_target" --profile "$profile" --import-profile "${TERMINAL_ELECTRON_SLACK_DESKTOP_PROFILE:-$HOME/Library/Application Support/$app_name}" "$@"
